---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import StaffCard from '@/components/StaffCard.astro';
import DemoNote from '@/components/DemoNote.astro';
import { staff } from '@/data/staff';
---

<BaseLayout title="スタッフ" description="TRUNKのスタッフ4人の紹介。（デモプロフィール）">
  <section class="page-head section--tight">
    <div class="wrap">
      <SectionHead en="People" jp="スタッフ" level="h1" />
      <p class="page-head__lead" data-reveal>
        スタイリスト3人とアシスタント1人の、小さなチームです。<br />
        得意なことと、話し方の温度を、少しだけ。
      </p>
      <DemoNote text="デモプロフィールです。氏名・役職・紹介文は仮で、写真は素材写真です。実在のスタッフではありません。" />
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap">
      <ol class="people">
        {staff.map((m, i) => (
          <li><StaffCard member={m} index={i} detailed heading="h2" loading={i < 2 ? 'eager' : 'lazy'} sizes="(min-width: 900px) 22vw, 46vw" /></li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding-top: clamp(28px, 4vw, 56px); }
  .page-head__lead { max-width: 34em; margin: -8px 0 20px; }
  .people { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 12px; }
  @media (min-width: 600px) { .people { gap: 40px 24px; } }
  @media (min-width: 900px) { .people { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 clamp(20px, 2.5vw, 40px); } }
</style>
